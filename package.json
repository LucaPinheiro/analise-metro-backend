{
    "name": "metro-sp-pipeline-backend",
    "version": "1.0.0",
    "packageManager": "bun@1.4.2",
    "description": "Backend para gerenciamento de pipeline de processamento de imagens e comparação BIM",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "prisma generate && tsc",
        "start": "node dist/index.js",
        "type-check": "prisma generate && tsc --noEmit",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "seed": "tsx prisma/seed.ts",
        "seed:reset": "tsx prisma/seed.ts --reset",
        "create-project": "tsx scripts/create-project-manual.ts",
        "clear-db": "tsx scripts/clear-db.ts"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "keywords": [
        "metro-sp",
        "bim",
        "computer-vision",
        "pipeline"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "6.19.3",
        "cors": "2.8.6",
        "dotenv": "18.0.10",
        "express": "5.3.0",
        "multer": "2.5.0",
        "pg": "8.23.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "5.0.6",
        "@types/multer": "2.3.0",
        "@types/node": "26.6.6",
        "@types/pg": "8.23.1",
        "@typescript-eslint/eslint-plugin": "8.73.0",
        "@typescript-eslint/parser": "8.73.0",
        "prettier": "3.10.1",
        "prisma": "6.19.3",
        "tsx": "4.23.15",
        "typescript": "5.9.3"
    },
    "overrides": {
        "deepmerge-ts": "^8.0.0"
    }
}
